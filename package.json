{
  "name": "arus-inspector",
  "version": "0.2.0",
  "description": "A focused desktop HTTP traffic inspector",
  "main": "src/main.cjs",
  "author": "Muhammad Diemas Mahendra",
  "license": "MIT",
  "repository": "https://github.com/diemasmahendra/arus-inspector",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "node test/e2e.cjs",
    "check": "node --check src/main.cjs && node --check src/capture.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check src/engine.cjs && node --check src/agent.cjs && node --check src/agent-ui.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "whistle": "2.10.10"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "tech.diemas.arus",
    "productName": "Arus",
    "artifactName": "Arus-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "diemasmahendra",
      "repo": "arus-inspector",
      "releaseType": "release"
    }
  }
}
